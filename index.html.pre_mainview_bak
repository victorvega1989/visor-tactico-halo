              <tr><td><strong>ASALTO (Atacante)</strong></td><td>Detonado por mover hacia el cubo (Carga)</td><td><strong style="color:#8df5a0;">+2 dados</strong></td></tr>
              <tr><td><strong>ASALTO (Ambos)</strong></td><td>Otro modelo aliado en el mismo cubo</td><td><strong style="color:#8df5a0;">+1 dado</strong></td></tr>
