      font-size: 0.82rem;
      font-weight: 700;
      cursor: pointer;
      opacity: 0.45;
      transition: all 0.25s ease;
      user-select: none;
    }
    .dice-toggle-chip:hover {
      opacity: 0.85;
      border-color: #ca8a04;
      color: #fef08a;
    }
    .dice-toggle-chip.active {
      opacity: 1;
      background: rgba(234, 179, 8, 0.22);
      color: #fef08a;
      border-color: #eab308;
      box-shadow: 0 0 14px rgba(234, 179, 8, 0.5);
    }
    .dice-scoreboard-box {
      background: rgba(8, 15, 23, 0.95);
      border: 1px solid #283c54;
      border-radius: 6px;
      padding: 14px 18px;
      margin-top: 14px;
      display: flex;
      flex-direction: column;
      gap: 10px;
      align-items: center;
    }
    .dice-scoreboard-row {
      display: flex;
      align-items: center;
      justify-content: space-around;
      width: 100%;
      font-family: 'Share Tech Mono', monospace;
      font-size: 0.95rem;
      color: #94a3b8;
    }
    .dice-scoreboard-score {
      font-size: 1.4rem;
      font-weight: 800;
      color: #fff;
      margin-left: 6px;
    }
    .dice-scoreboard-badge {
      display: inline-block;
      padding: 6px 18px;
      border-radius: 4px;
      font-family: 'Rajdhani', sans-serif;
      font-weight: 800;
      font-size: 1.25rem;
      letter-spacing: 1px;
      text-transform: uppercase;
      text-align: center;
      transition: all 0.2s;
    }
    .dice-scoreboard-badge.hit {
      background: rgba(16, 185, 129, 0.2);
      color: #8df5a0;
      border: 1px solid #10b981;
      box-shadow: 0 0 14px rgba(16, 185, 129, 0.35);
    }
    .dice-scoreboard-badge.tied {
      background: rgba(234, 179, 8, 0.18);
      color: #fde047;
      border: 1px solid #eab308;
    }
    .dice-scoreboard-badge.fail {
      background: rgba(100, 116, 139, 0.2);
      color: #94a3b8;
      border: 1px solid #475569;
    }
    .dice-scoreboard-badge.idle {
      background: transparent;
      color: #64748b;
      border: 1px dashed #334155;
      font-size: 0.95rem;
      font-weight: 600;
      font-family: 'Share Tech Mono', monospace;
    }
    .dice-grid {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
      min-height: 80px;
      padding: 10px;
      background: rgba(0, 0, 0, 0.35);
      border-radius: 4px;
      align-items: center;
      justify-content: center;
    }

    /* FORMA D8 (OCTAGONAL ESTILIZADA) */
    .d8-die {
      position: relative;
      width: 54px;
      height: 62px;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      font-family: 'Rajdhani', sans-serif;
      font-weight: 800;
      cursor: default;
      clip-path: polygon(50% 0%, 92% 24%, 100% 50%, 92% 76%, 50% 100%, 8% 76%, 0% 50%, 8% 24%);
      box-shadow: 0 4px 10px rgba(0,0,0,0.5);
      transition: all 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
      user-select: none;
    }
    .d8-die-val {
      font-size: 1.65rem;
      line-height: 1;
      font-family: 'Share Tech Mono', monospace;
    }
    .d8-die-badge {
      font-size: 0.62rem;
      font-family: 'Share Tech Mono', monospace;
      margin-top: 2px;
      font-weight: bold;
      letter-spacing: -0.5px;
    }

    /* DADO BLANCO (ATACANTE) */
    .d8-die.white {
      background: linear-gradient(145deg, #ffffff, #cbd5e1);
      color: #0f172a;
    }
    .d8-die.white.success {
      background: linear-gradient(145deg, #dcfce7, #86efac);
      color: #14532d;
      box-shadow: 0 0 12px rgba(34, 197, 94, 0.6);
    }
    .d8-die.white.headshot {
      background: linear-gradient(145deg, #fef08a, #eab308);
      color: #713f12;
      box-shadow: 0 0 16px rgba(234, 179, 8, 0.85);
      animation: pulseHeadshot 1s infinite alternate;
    }
    .d8-die.white.fail {
      opacity: 0.38;
      background: linear-gradient(145deg, #94a3b8, #64748b);
      color: #334155;
      filter: grayscale(0.8);
    }

    /* DADO NEGRO (DEFENSOR) */
    .d8-die.black {
      background: linear-gradient(145deg, #1e293b, #090d16);
      color: #e2e8f0;
      border: 1px solid #334155;
    }
    .d8-die.black.success {
      background: linear-gradient(145deg, #064e3b, #047857);
      color: #6ee7b7;
      box-shadow: 0 0 12px rgba(16, 185, 129, 0.6);
    }
    .d8-die.black.headshot {
      background: linear-gradient(145deg, #713f12, #854d0e);
      color: #fef08a;
      box-shadow: 0 0 16px rgba(234, 179, 8, 0.85);
      border-color: #facc15;
    }
    .d8-die.black.fail {
      opacity: 0.38;
      background: linear-gradient(145deg, #1e293b, #0f172a);
      color: #64748b;
      filter: grayscale(0.8);
    }

    @keyframes pulseHeadshot {
      0% { transform: scale(1); box-shadow: 0 0 12px rgba(234, 179, 8, 0.7); }
      100% { transform: scale(1.08); box-shadow: 0 0 20px rgba(234, 179, 8, 1); }
    }
    @keyframes diceRollingFast {
      0% { transform: scale(0.95) rotate(-12deg); }
      50% { transform: scale(1.05) rotate(12deg); }
      100% { transform: scale(0.95) rotate(-12deg); }
    }
    @keyframes diceRollingMed {
      0% { transform: scale(0.98) rotate(-6deg); }
      50% { transform: scale(1.02) rotate(6deg); }
      100% { transform: scale(0.98) rotate(-6deg); }
    }
    @keyframes diceRollingSlow {
      0% { transform: scale(0.99) rotate(-2deg); }
      50% { transform: scale(1.01) rotate(2deg); }
      100% { transform: scale(0.99) rotate(-2deg); }
    }
    .d8-die.rolling-fast {
      animation: diceRollingFast 0.24s infinite ease-in-out;
    }
    .d8-die.rolling-med {
      animation: diceRollingMed 0.38s infinite ease-in-out;
    }
    .d8-die.rolling-slow {
      animation: diceRollingSlow 0.55s infinite ease-in-out;
    }
    .d8-die.rolling {
      animation: diceRollingFast 0.24s infinite ease-in-out;
    }

    /* PESTAÑAS Y HERRAMIENTAS DEL CENTRO TÁCTICO DE DADOS */
    .dice-nav-tabs {
      display: flex; gap: 6px; flex-wrap: wrap; margin-bottom: 14px;
      border-bottom: 1px solid rgba(0, 210, 255, 0.25); padding-bottom: 8px;
    }
    .dice-tab-btn {
      background: rgba(18, 26, 36, 0.85); color: #7b96b3; border: 1px solid #283c54;
      padding: 6px 12px; font-family: 'Share Tech Mono', monospace; font-size: 0.78rem;
      cursor: pointer; transition: all 0.2s; border-radius: 3px; font-weight: 700;
    }
    .dice-tab-btn:hover {
      color: #fff; border-color: #00d2ff; background: rgba(0, 210, 255, 0.1);
    }
    .dice-tab-btn.active {
      background: #11696b; color: #8df5a0; border-color: #8df5a0;
      box-shadow: 0 0 10px rgba(141, 245, 160, 0.25);
    }
    .dice-panel { display: none; }
    .dice-panel.active { display: block; animation: fadeInCard 0.2s ease-out; }

    /* MARCADOR DE PARTIDA (RONDAS Y PUNTOS DE VICTORIA) */
    .game-tracker-bar {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: center;
      gap: 12px;
      background: rgba(6, 12, 19, 0.95);
      border: 1px solid #283c54;
      border-radius: 6px;
      padding: 8px 12px;
      margin-bottom: 12px;
      font-family: 'Share Tech Mono', monospace;
      text-align: center;
    }
    .game-tracker-group {
      display: flex;
      align-items: center;
      justify-content: center;
      text-align: center;
      gap: 6px;
      font-size: 0.85rem;
      flex-wrap: wrap;
    }
    .game-tracker-step-btn {
      background: #1e293b;
      color: #fff;
      border: 1px solid #475569;
      width: 24px;
      height: 24px;
      border-radius: 3px;
      cursor: pointer;
      font-weight: bold;
      font-size: 1rem;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: all 0.15s;
    }
    .game-tracker-step-btn:hover {
      background: #00d2ff;
      color: #050b14;
      border-color: #00d2ff;
    }
    .game-tracker-val {
      font-size: 1.15rem;
      font-weight: 800;
      color: #fff;
      min-width: 20px;
      text-align: center;
    }

    /* DADOS DE MANDO (COMMAND DICE) */
    .cmd-player-card {
      background: rgba(13, 20, 30, 0.85);
      border: 1px solid #283c54;
      border-radius: 6px;
      padding: 12px;
      display: flex;
      flex-direction: column;
      gap: 10px;
    }
    .cmd-player-card.p1 { border-left: 4px solid #ef4444; }
    .cmd-player-card.p2 { border-left: 4px solid #00d2ff; }
    .cmd-dice-grid {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      min-height: 90px;
      padding: 8px;
      background: rgba(0, 0, 0, 0.35);
      border-radius: 4px;
      align-items: center;
      justify-content: center;
    }
    .cmd-die {
      position: relative;
      width: 80px;
      min-height: 84px;
      background: linear-gradient(145deg, #182535, #0a111a);
      border: 1.5px solid #283c54;
      border-radius: 8px;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: 6px 4px;
      cursor: pointer;
      transition: all 0.2s;
      user-select: none;
    }
    .cmd-die:hover {
      border-color: #00d2ff;
      box-shadow: 0 0 10px rgba(0, 210, 255, 0.3);
      transform: translateY(-2px);
    }
    .cmd-die.spent {
      opacity: 0.35;
      filter: grayscale(0.85);
      border-style: dashed;
    }
    .cmd-die.spent::after {
      content: "USADO";
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%) rotate(-25deg);
      font-family: 'Share Tech Mono', monospace;
      font-size: 0.72rem;
      font-weight: 900;
      color: #ef4444;
      border: 1px solid #ef4444;
      padding: 1px 4px;
      border-radius: 3px;
      background: rgba(0, 0, 0, 0.85);
      white-space: nowrap;
    }
    .cmd-die.rolling {
      animation: diceRollingFast 0.24s infinite ease-in-out;
    }
    .cmd-die-icon {
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .cmd-die-title {
      font-family: 'Share Tech Mono', monospace;
      font-size: 0.65rem;
      font-weight: 800;
      text-align: center;
      color: #8df5a0;
      letter-spacing: -0.2px;
      line-height: 1.1;
      margin-top: 4px;
      text-transform: uppercase;
    }

    /* PLANTILLA DE DISPERSIÓN 3X3 */
    .scatter-grid {
      display: grid;
      grid-template-columns: repeat(3, 72px);
      grid-template-rows: repeat(3, 72px);
      gap: 6px;
      justify-content: center;
      margin: 12px auto;
    }
    .scatter-cell {
      background: rgba(18, 26, 36, 0.9);
      border: 2px solid #283c54;
      border-radius: 6px;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      font-family: 'Share Tech Mono', monospace;
      font-size: 1.6rem;
      font-weight: 800;
      color: #7b96b3;
      transition: all 0.25s;
      user-select: none;
    }
    .scatter-cell.center {
      background: rgba(0, 210, 255, 0.08);
      border-color: #00d2ff;
      color: #00d2ff;
      font-size: 1.8rem;
    }
    .scatter-cell.active {
      background: rgba(0, 210, 255, 0.35);
      border-color: #00d2ff;
      color: #fff;
      box-shadow: 0 0 16px rgba(0, 210, 255, 0.7);
      transform: scale(1.08);
    }
    .recon-effect-card {
      background: rgba(8, 15, 23, 0.95);
      border: 1px solid #283c54;
      border-radius: 6px;
      padding: 12px 16px;
      margin-top: 10px;
      text-align: center;
    }

    /* MODAL BARRACONES Y ARMERÍA */
    .armory-nav-tabs {
      display: flex; gap: 6px; flex-wrap: wrap; margin-bottom: 20px;
      border-bottom: 1px solid rgba(0, 210, 255, 0.25); padding-bottom: 8px;
    }
    .armory-tab-btn {
      background: rgba(18, 26, 36, 0.8); color: #7b96b3; border: 1px solid #283c54;
      padding: 8px 12px; font-family: 'Share Tech Mono', monospace; font-size: 0.78rem;
      cursor: pointer; transition: all 0.2s; border-radius: 3px; font-weight: 700;
    }
    .armory-tab-btn:hover {
      color: #fff; border-color: var(--text-cyan); background: rgba(0, 210, 255, 0.1);
    }
    .armory-tab-btn.active {
      background: #11696b; color: #8df5a0; border-color: #8df5a0;
      box-shadow: 0 0 10px rgba(141, 245, 160, 0.25);
    }
    .armory-panel { display: none; }
    .armory-panel.active { display: block; animation: fadeInCard 0.2s ease-out; }
    
    .armory-form-grid {
      display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
      gap: 12px; margin-bottom: 16px;
    }
    .armory-form-group { display: flex; flex-direction: column; gap: 5px; }
    .armory-form-group label {
      font-family: 'Share Tech Mono', monospace; font-size: 0.72rem; color: #8df5a0; text-transform: uppercase;
    }
    .armory-form-group input, .armory-form-group select, .armory-form-group textarea {
      background: rgba(0, 0, 0, 0.6); color: #fff; border: 1px solid #283c54; padding: 7px 10px;
      font-family: 'Rajdhani', sans-serif; font-size: 0.95rem; outline: none; border-radius: 3px;
    }
    .armory-form-group input:focus, .armory-form-group select:focus, .armory-form-group textarea:focus {
      border-color: var(--text-cyan); box-shadow: 0 0 8px rgba(0,210,255,0.3);
    }
    .armory-btn-submit {
      background: #11696b; color: #fff; border: 1px solid var(--border-cyan);
      padding: 10px 22px; font-family: 'Share Tech Mono', monospace; font-size: 0.85rem; font-weight: bold;
      cursor: pointer; border-radius: 3px; transition: all 0.2s;
    }
    .armory-btn-submit:hover {
      background: #00d2ff; color: #050b14; box-shadow: 0 0 12px rgba(0,210,255,0.4);
    }
    .armory-items-list {
      margin-top: 18px; display: flex; flex-direction: column; gap: 8px;
      max-height: 280px; overflow-y: auto; padding-right: 4px;
    }
    .armory-item-card {
      background: rgba(18, 26, 36, 0.85); border: 1px solid #283c54;
      padding: 10px 14px; border-radius: 4px; display: flex;
      justify-content: space-between; align-items: center; gap: 10px;
    }
    .armory-item-card:hover { border-color: rgba(0, 210, 255, 0.4); }
    .armory-item-title { font-weight: 700; color: #fff; font-size: 1rem; }
    .armory-item-desc { font-size: 0.82rem; color: #94a3b8; }
    .armory-btn-del {
      background: transparent; border: 1px solid #ef4444; color: #ef4444;
      padding: 4px 10px; font-size: 0.75rem; cursor: pointer; border-radius: 3px;
      font-family: 'Share Tech Mono', monospace;
    }
    .armory-btn-del:hover { background: #ef4444; color: #fff; }

    /* GALERÍA DE FOTOS DE MINIATURAS */
    .mini-gallery-grid {
      display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
      gap: 14px; max-height: 480px; overflow-y: auto; padding-right: 6px;
    }
    .mini-gallery-card {
      background: rgba(10, 16, 26, 0.9); border: 1px solid #283c54;
      border-radius: 4px; overflow: hidden; display: flex; flex-direction: column;
      transition: all 0.2s;
    }
    .mini-gallery-card:hover { border-color: var(--text-cyan); box-shadow: 0 4px 14px rgba(0,210,255,0.2); }
    .mini-gallery-img {
      width: 100%; height: 150px; object-fit: cover; object-position: top;
      background: #08111e;
    }
    .mini-gallery-info { padding: 10px; display: flex; flex-direction: column; gap: 6px; flex: 1; }
    .mini-gallery-name { font-weight: 700; font-size: 0.95rem; color: #fff; line-height: 1.2; }
    .mini-gallery-badge {
      font-family: 'Share Tech Mono', monospace; font-size: 0.65rem; padding: 2px 6px;
      border-radius: 3px; width: fit-content;
    }
    .mini-gallery-badge.custom { background: rgba(141, 245, 160, 0.2); color: #8df5a0; border: 1px solid #8df5a0; }
    .mini-gallery-badge.official { background: rgba(0, 210, 255, 0.15); color: #00d2ff; }
    .mini-gallery-actions { display: flex; gap: 6px; margin-top: auto; }

    /* CHIPS PARA PALABRAS CLAVE EN FORMULARIO */
    .kw-chip-grid {
      display: flex; flex-wrap: wrap; gap: 6px; max-height: 160px;
      overflow-y: auto; background: rgba(0,0,0,0.4); padding: 8px; border-radius: 4px;
      border: 1px solid #283c54;
    }
    .kw-chip-label {
      display: inline-flex; align-items: center; gap: 4px; background: rgba(18, 26, 36, 0.9);
      border: 1px solid #283c54; padding: 3px 8px; border-radius: 3px; font-size: 0.75rem;
      cursor: pointer; user-select: none; color: #cbd5e1;
    }
    .kw-chip-label:hover { border-color: var(--text-cyan); color: #fff; }
    .kw-chip-label input[type="checkbox"] { display: inline-block; margin: 0; width: auto; }

    /* RESPONSIVE MÓVIL Y TABLET */
    @media (max-width: 850px) {
      body { flex-direction: column; height: 100vh; }
      aside {
        width: 100%; min-width: 100%; height: auto; max-height: 48vh;
        border-right: none; border-bottom: 2px solid var(--border-cyan);
      }
      main { height: 52vh; padding: 14px 10px; }
      .ws-top-grid { grid-template-columns: 1fr; gap: 12px; }
      .ws-unit-art-wrapper { max-height: 220px; }
      .core-stats-table { width: 100%; }
      .shapes-container { justify-content: center; padding: 0; }
      .modal-content { max-height: 90vh; margin: 15px; width: calc(100% - 30px); }
    }

