                <div class="cmd-die-title">${f.name}</div>
              </div>
            `;
          }).join('');
        }
        fIdx++;
        if (fIdx < frames.length) {
          setTimeout(step, frames[fIdx]);
        } else {
          finalizeCommandDice(player, count);
          if (btnRoll) btnRoll.disabled = false;
        }
      }
      step();
    };

