        return new Promise((resolve, reject) => {
          const tx = db.transaction('unitPhotos', 'readwrite');
          const store = tx.objectStore('unitPhotos');
          const req = store.delete(unitId);
          req.onsuccess = () => resolve(true);
          req.onerror = () => reject(req.error);
